{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "command": "/usr/bin/env python3 \"$(git rev-parse --show-toplevel)/cursor/.cursor/hooks/session_start_context.py\"",
        "timeout": 10
      }
    ],
    "beforeShellExecution": [
      {
        "type": "command",
        "command": "/usr/bin/env python3 \"$(git rev-parse --show-toplevel)/cursor/.cursor/hooks/pre_tool_use_policy.py\"",
        "timeout": 10
      }
    ],
    "beforeSubmitPrompt": [
      {
        "type": "command",
        "command": "/usr/bin/env python3 \"$(git rev-parse --show-toplevel)/cursor/.cursor/hooks/user_prompt_submit_guard.py\"",
        "timeout": 10
      }
    ],
    "stop": [
      {
        "type": "command",
        "command": "/usr/bin/env python3 \"$(git rev-parse --show-toplevel)/cursor/.cursor/hooks/stop_quality_gate.py\"",
        "timeout": 10,
        "loop_limit": 1
      }
    ]
  }
}
